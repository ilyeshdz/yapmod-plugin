{
  "name": "yapmod-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Yapmod plugin catalog by ilyeshdz.",
  "keywords": [
    "plugins",
    "yapmod"
  ],
  "license": "MIT",
  "author": "ilyeshdz",
  "scripts": {
    "build": "pnpm typecheck && pnpm test && node scripts/plugins.mjs build",
    "dev": "node scripts/plugins.mjs dev",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "devDependencies": {
    "@yapmod/builder": "^1.3.0",
    "@yapmod/types": "^1.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solid-js": "^1.9.18",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.10.1"
}
